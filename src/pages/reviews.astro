---
// imports stay the same
import Layout from '../layouts/Layout.astro';
import '../styles/index.css';
import '../styles/cards.css';
import '../styles/search.css';
import '../styles/simGlobal.css';
import { site } from '../config/site.js';
import PostCard from "../components/postCard.astro";


// 1) load and sort all posts
const allPosts = Object.values(
  import.meta.glob('./posts/*.{md,mdx}', { eager: true })
) as any[];
const visiblePosts = allPosts.filter(({ frontmatter }) => !frontmatter?.hidden);
visiblePosts.sort(
  (a, b) => new Date(b.frontmatter.pubDate).getTime() - new Date(a.frontmatter.pubDate).getTime()
);

// helpers
function normalizeCat(cat: unknown): string[] {
  if (!cat) return [];
  if (Array.isArray(cat)) return cat.filter(Boolean).map((c) => String(c).toLowerCase());
  return [String(cat).toLowerCase()];
}
function hasCat(frontmatter: any, needle: string) {
  return normalizeCat(frontmatter.category ?? frontmatter.categories).includes(needle);
}
function alphabetizedByCategory(key: string) {
  return visiblePosts
    .filter(({ frontmatter }) => hasCat(frontmatter, key))
    .sort((a, b) =>
      String(a.frontmatter.title ?? '').localeCompare(
        String(b.frontmatter.title ?? ''),
        'en',
        { sensitivity: 'base' }
      )
    );
}

function groupByInitial(posts: any[]) {
  const groups = new Map<string, any[]>();

  for (const post of posts) {
    const initial = String(post.frontmatter.title ?? '').trim().charAt(0).toUpperCase();
    if (!/^[A-Z]$/.test(initial)) continue;
    const group = groups.get(initial) ?? [];
    group.push(post);
    groups.set(initial, group);
  }

  return Array.from(groups, ([letter, items]) => ({ letter, items }));
}

// category config
const CATS = [
  { key: 'simulation',    label: 'Interactives',    cta: 'Go to the story →', link: '/interactives' },
  // { key: 'informational', label: 'Informational Posts',         cta: 'Read the guide →' },
  // { key: 'nasa',          label: 'NASA Posts',           cta: 'See the article →' },
];

// Page-wide A–Z jump index: only letters that actually have posts, in order,
// pointing at the first matching letter header on the page.
function anchorId(catKey: string, letter: string) {
  return `letter-${catKey}-${letter}`;
}

const letterIndex = new Map<string, string>();
for (const cat of CATS) {
  const groups = groupByInitial(alphabetizedByCategory(cat.key));
  for (const { letter } of groups) {
    if (!letterIndex.has(letter)) {
      letterIndex.set(letter, anchorId(cat.key, letter));
    }
  }
}
const alphabetLinks = Array.from(letterIndex.entries()).sort(([a], [b]) => a.localeCompare(b));

---

<Layout title="Home">
  {alphabetLinks.length > 0 && (
    <nav class="az-nav" aria-label="Jump to letter">
      <ul>
        {alphabetLinks.map(([letter, id]) => (
          <li>
            <a href={`#${id}`}>{letter}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}

  <section class="centered_flex home-main-section">
    <div class="home-hero-sim">
      <div class="hero-sim-wrap">
<section class="hero centered_flex fade-up">
          <span class="hero-title">{site.name}</span>
          <h1 class="home-kicker">{site.description}</h1>
          <h2 class="home-kicker-2">{site.secondDescription}</h1>
        </section>

      </div>
	    </div>

    <!-- Latest by category (stacked sections) -->
    <section class="latest-section">
      {CATS.map((cat) => {
        const items = alphabetizedByCategory(cat.key);
        const groups = groupByInitial(items);
        if (items.length === 0) return null;

        return (
          <div class="post-grid flex_centered">
            {groups.map(({ letter, items: groupedItems }) => (
              <>
                <h3 id={anchorId(cat.key, letter)} class="home-category-title home-letter-title">
                  <span class="latest-title">{letter}</span>
                </h3>
                {groupedItems.map(({ frontmatter, url }) => (
                  <PostCard
                    url={url}
                    frontmatter={frontmatter}
                    row
                    compact
                  />
                ))}
              </>
            ))}
            </div>
          <span class="divider"></span>
        );
      })}
    </section>
    </section>

  <script>
    // Smooth-scroll the A–Z jump nav to its target letter header, landing it
    // just under the fixed site header. Falls back to a plain anchor jump
    // (still positioned correctly via scroll-margin-top) without JS.
    document.querySelectorAll('.az-nav a').forEach((link) => {
      link.addEventListener('click', (event) => {
        const id = link.getAttribute('href')?.slice(1);
        const target = id ? document.getElementById(id) : null;
        if (!target) return;
        event.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        history.pushState(null, '', `#${id}`);
      });
    });
  </script>
</Layout>
