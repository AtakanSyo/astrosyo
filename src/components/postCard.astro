---
/**
 * PostCard.astro
 * Usage:
 * <PostCard url={post.url} frontmatter={post.frontmatter} row />
 */

const {
  url = "#",
  frontmatter = {},
  row = false,
  compact = false,
} = Astro.props;

const title = frontmatter.title ?? "";
const thumbnail = frontmatter.thumbnail ?? "";
const hasThumb = Boolean(thumbnail);
const rawPostColor = typeof frontmatter.postColor === "string" ? frontmatter.postColor.trim() : "";
const rgbaMatch = rawPostColor.match(
  /^rgba\(\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(0|1|0?\.\d+)\s*\)$/i
);
let postColor = "";
let inversePostColor = "";

if (rgbaMatch) {
  const red = Number(rgbaMatch[1]);
  const green = Number(rgbaMatch[2]);
  const blue = Number(rgbaMatch[3]);
  const alpha = Number(rgbaMatch[4]);
  const validColor = [red, green, blue].every((value) => value >= 0 && value <= 255) && alpha >= 0 && alpha <= 1;

  if (validColor) {
    postColor = rawPostColor;
    inversePostColor = `rgba(${255 - red},${255 - green},${255 - blue},1)`;
  }
}

const cardStyle = [
  postColor && `--post-card-bg: ${postColor}`,
  inversePostColor && `--post-card-bg-inverse: ${inversePostColor}`,
].filter(Boolean).join("; ");

const cardClass = [
  "post-card",
  row && "post-card--row",
  !hasThumb && "post-card--no-thumb",
  compact && "post-card--compact",
].filter(Boolean).join(" ");
const linkClass = [
  "post-card-link",
  row && "post-card-link--row",
  hasThumb && !row && "post-card-link--overlay",
  compact && "post-card-link--compact",
].filter(Boolean).join(" ");

import '../styles/cards.css';
---

<div class={cardClass} style={cardStyle}>
  <a href={url} class={linkClass}>
    {thumbnail && (
      <div class="post-card-thumb">
        <img
          src={thumbnail}
          alt={title}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class="post-card-info centered_flex">
      <div class="post-card-title">{title}</div>
    </div>

    {row && (
      <span class="post-card-row-arrow" aria-hidden="true">→</span>
    )}
  </a>
</div>
