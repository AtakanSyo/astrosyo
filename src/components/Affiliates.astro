---
export interface Props {
  affiliate: {
    amazon?: string;
    highpointscientific?: string;
    astroshop?: string;
  };
}

const { affiliate } = Astro.props as Props;

const title = 'Available at These Vendors';

// One row per store that has a link; region is where the store mainly sells.
const vendors = [
  { name: 'Amazon', region: 'Global', desc: 'Recommended for smaller purchases.', link: affiliate.amazon },
  { name: 'HighPoint Scientific', region: 'US', desc: 'Great customer support & expert guidance.', link: affiliate.highpointscientific },
  { name: 'AstroShop', region: 'EU', desc: 'Recommended for EU customers.', link: affiliate.astroshop },
].filter((v) => v.link);
---

{vendors.length > 0 && (
<section class="affiliate-section centered_flex">

  <h3 class="affiliate-section-title">{title}</h3>

  <ul class="affiliate-vendors">
    {vendors.map(({ name, region, desc, link }) => (
      <li>
        <a href={link} target="_blank" rel="noopener noreferrer sponsored nofollow" class="vendor-card">
          <div class="vendor-info">
            <div class="vendor-head">
              <h4 class="vendor-name">{name}</h4>
              <span class="vendor-region">{region}</span>
            </div>
            <p class="vendor-desc">{desc}</p>
          </div>
          <span class="vendor-button">Check price ↗</span>
        </a>
      </li>
    ))}
  </ul>

</section>
)}
