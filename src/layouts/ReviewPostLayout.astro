---
import Layout from './Layout.astro';
import '@fontsource/poiret-one';
import '../styles/postsGlobal.css';
import '../styles/reviewPost.css';
import '../styles/reviewHero.css';
import '../styles/reviewLight.css';
import FeedbackCTA from '../components/FeedbackCTA.astro';
import ScoreBadge from '../components/ScoreBadge.astro';
import { getVendors } from '../utils/vendors.js';
import { coverFraming } from '../utils/coverFraming.js';

const { url } = Astro.props;

const {
  title,
  description,
  writer,
  pubDate,
  updatedDate,
  cover_image,
  rating = {}
} = Astro.props.frontmatter;

const ratingsArray = [
  { category: "Overall", value: rating.overall },
  { category: "Optics", value: rating.optics },
  { category: "Mount", value: rating.mount },
  { category: "Accessories", value: rating.accessories }
].filter(r => r.value !== undefined);

const jsonLdProduct = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": title,
  "description": description,
  "review": {
    "@type": "Review",
    "author": { "@type": "Person", "name": writer },
    "datePublished": pubDate,
    "dateModified": updatedDate || pubDate,
    "reviewBody": description,
    "reviewRating": {
      "@type": "Rating",
      "ratingValue": rating.overall,
      "bestRating": "10",
      "worstRating": "1"
    }
  }
};

function parseScore(v: unknown): number | null {
  if (v === undefined || v === null || v === '') return null;
  if (typeof v === 'number' && Number.isFinite(v)) return Math.max(0, Math.min(10, v));

  const s = String(v).trim().toLowerCase();
  const m = s.match(/^(\d+(?:\.\d+)?)(?:\s*\/\s*(\d+(?:\.\d+)?))?$/);
  if (m) {
    const num = parseFloat(m[1]);
    const den = m[2] ? parseFloat(m[2]) : 10;
    if (!Number.isNaN(num) && !Number.isNaN(den) && den > 0) {
      return Math.max(0, Math.min(10, (num / den) * 10));
    }
  }

  const map: Record<string, number> = { a: 9.5, 'a-': 9, 'b+': 8.5, b: 8, 'b-': 7.5, c: 7, 'c-': 6.5 };
  return map[s] ?? null;
}

const overallNum = parseScore(rating?.overall);

// Re-framed covers (1600 x 1600 squares) are shown zoomed in so the
// telescope fills the photo area; older covers keep the regular styling.
const framing = await coverFraming(cover_image, Astro.props.frontmatter.coverFraming);

// Small label above the title, e.g. "Hands-on review · Telescopes".
const reviewType = Astro.props.frontmatter.reviewType;
const kind = reviewType === 'hands-on' ? 'Hands-on review' : reviewType === 'research' ? 'Research review' : 'Review';
const sub = Astro.props.frontmatter.subcategory;
const eyebrow = sub ? `${kind} · ${String(sub).charAt(0).toUpperCase()}${String(sub).slice(1)}` : kind;

const vendors = getVendors(Astro.props.frontmatter.affiliate ?? {});

// Research reviews invite owners to send in a hands-on review: an email
// pre-filled with the telescope's name and a short template.
const CONTRIBUTE_EMAIL = 'astrosyo.contact@gmail.com';
const scopeName = String(title).replace(/\s+(Review|Overview)$/i, '');
const contributeHref =
  `mailto:${CONTRIBUTE_EMAIL}` +
  `?subject=${encodeURIComponent(`Hands-on review: ${scopeName}`)}` +
  `&body=${encodeURIComponent(
    [
      `Telescope: ${scopeName}`,
      'How long have you owned it?',
      'Your name, as you would like to be credited:',
      '',
      'Scores out of 10',
      'Optics:',
      'Mount:',
      'Accessories:',
      '',
      'What you like:',
      'What you would change:',
      '',
      'Your review (as long or short as you like):',
      '',
      '',
      'Photos: attach any you took of the telescope or through it.',
    ].join('\n')
  )}`;
---

<Layout
  title={title}
  description={description}
  category={Astro.props.frontmatter?.category}
  image={cover_image}
  ogType="article"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdProduct).replace(/</g, "\\u003c")}></script>
    {cover_image && <link rel="preload" as="image" href={cover_image} />}
  </Fragment>

{Astro.props.frontmatter?.theme === 'light' && <div class="review-light" hidden></div>}

<div class="centered_flex">

  <!-- Full-width header. The cover photo is used twice: blurred and stretched
       to fill the band (so any photo fits any screen shape), and sharp, with
       its edges faded, beside the text. -->
  <section class={`review-hero${framing === 'framed' ? ' review-hero--framed' : ''}`}>
    <div class="review-hero-bg" aria-hidden="true">
      {cover_image && <div class="review-hero-backdrop" style={`background-image: url('${cover_image}')`}></div>}
      <div class="review-hero-scrim"></div>
    </div>

    {cover_image && (
      <div class="review-hero-media">
        <img
          src={cover_image}
          class="review-hero-image"
          alt={title + ' cover'}
          fetchpriority="high"
          loading="eager"
          decoding="async"
        />
      </div>
    )}

    <div class="review-hero-content">
      <p class="review-hero-eyebrow">{eyebrow}</p>
      <h1 class="review-title">{title}</h1>
      {Astro.props.frontmatter.tagline && (
        <p class="review-tagline">{Astro.props.frontmatter.tagline}</p>
      )}

      <div class="review-hero-summary">
        <div class="main-rating-card rating-card">
          <ScoreBadge score={overallNum ?? undefined} size={84} />
          <span class="category">Overall</span>
        </div>
        <p class="review-hero-desc">{description}</p>
      </div>

      <div class="review-hero-actions">
        {vendors.length > 0 && (
          <details class="review-hero-price">
            <summary class="review-hero-btn review-hero-btn--primary">
              Check price <span class="review-hero-caret" aria-hidden="true"></span>
            </summary>
            <ul class="review-hero-menu">
              {vendors.map(({ name, region, link }) => (
                <li>
                  <a href={link} target="_blank" rel="noopener noreferrer sponsored nofollow">
                    <span class="review-hero-menu-name">{name}</span>
                    <span class="review-hero-menu-region">{region}</span>
                    <span class="review-hero-menu-arrow" aria-hidden="true">↗</span>
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )}
        <a class="review-hero-btn" href="#verdict" data-verdict-link>Jump to verdict</a>
      </div>

      {reviewType === 'research' && (
        <p class="review-hero-contribute">
          Own a {scopeName}?{' '}
          <a href={contributeHref}>Send us your hands-on review <span aria-hidden="true">→</span></a>
        </p>
      )}
    </div>
  </section>

  <article class="post review-post centered_flex">
    <slot />
  </article>

  <script is:inline>
    // Point "Jump to verdict" at the review's closing section, whatever it's
    // called; drop the button if there isn't one.
    (function () {
      var link = document.querySelector('[data-verdict-link]');
      if (!link) return;
      var heads = Array.prototype.slice.call(document.querySelectorAll('article.review-post h2')).reverse();
      var target = heads.find(function (h) { return /conclusion|verdict|final|bottom line|summary/i.test(h.textContent); });
      if (!target) { link.remove(); return; }
      if (!target.id) target.id = 'verdict';
      target.classList.add('review-anchor');
      link.setAttribute('href', '#' + target.id);
    })();

    // Close the "Check price" menu on a click outside it, on Escape, and
    // after a store is picked.
    (function () {
      var menu = document.querySelector('.review-hero-price');
      if (!menu) return;
      document.addEventListener('click', function (e) {
        if (menu.open && !menu.contains(e.target)) menu.open = false;
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && menu.open) {
          menu.open = false;
          menu.querySelector('summary').focus();
        }
      });
      menu.querySelectorAll('a').forEach(function (a) {
        a.addEventListener('click', function () { menu.open = false; });
      });
      // On every opening the menu unrolls from the top like a scroll and the
      // stores slide in one by one.
      menu.addEventListener('toggle', function () {
        if (!menu.open) return;
        var list = menu.querySelector('.review-hero-menu');
        if (!list || !list.animate || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        list.animate(
          [{ clipPath: 'inset(0 0 100% 0 round 12px)' }, { clipPath: 'inset(0 0 0 0 round 12px)' }],
          { duration: 380, easing: 'cubic-bezier(0.22, 0.8, 0.24, 1)' }
        );
        list.querySelectorAll('li').forEach(function (li, i) {
          li.animate(
            [{ opacity: 0, transform: 'translateY(-6px)' }, { opacity: 1, transform: 'none' }],
            { duration: 300, delay: 60 + i * 60, easing: 'ease-out', fill: 'backwards' }
          );
        });
      });
    })();
  </script>

  <FeedbackCTA />

</div>
</Layout>
