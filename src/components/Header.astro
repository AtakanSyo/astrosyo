---
interface Props {
  currentPath?: string;
}

import logoUrl from '../assets/images/shared/logo.svg?url';

const { currentPath = '' } = Astro.props as Props;

const labels = {
  home: 'Home',
  cosmicStories: 'Stories',
  telescopes: 'Telescopes',
  about: 'About',
  searchAria: 'Search posts',
  menuToggleAria: 'Toggle menu',
  searchToggleAria: 'Open search',
  searchCloseAria: 'Close search',
};

const siteName = Astro.site?.hostname ?? 'Astrosyo';

function normalizePath(path: string) {
  if (!path) return '/';
  const withoutQuery = path.split('?')[0]?.split('#')[0] ?? path;
  return withoutQuery.length > 1 ? withoutQuery.replace(/\/+$/, '') : withoutQuery;
}

function isCurrent(href: string) {
  return normalizePath(currentPath) === normalizePath(href);
}
---

<header>
  <div class="header-inner">
    <a href="/" class="logo centered_flex" aria-label={labels.home}>
      <img src={logoUrl} alt={siteName} />
    </a>

    <button
      class="nav-toggle"
      type="button"
      aria-label={labels.menuToggleAria}
      aria-controls="site-nav"
      aria-expanded="false"
    >
      <span class="hamburger"></span>
    </button>

    <nav class="site-nav" id="site-nav">
      <a href="/" class="nav-item" aria-current={isCurrent('/') ? 'page' : undefined}>
        {labels.home}
      </a>
      <a
        href="/telescopes"
        class="nav-item"
        aria-current={isCurrent('/telescopes') ? 'page' : undefined}
      >
        {labels.telescopes}
      </a>
      <a
        href="/stories"
        class="nav-item"
        aria-current={isCurrent('/stories') ? 'page' : undefined}
      >
        {labels.cosmicStories}
      </a>
      <a href="/calculators" class="nav-item" aria-current={isCurrent('/calculators') ? 'page' : undefined}>Calculators</a>
      <a
        href="/about"
        class="nav-item"
        aria-current={isCurrent('/about') ? 'page' : undefined}
      >
        {labels.about}
      </a>

      <button class="nav-search-toggle" aria-label={labels.searchToggleAria} type="button">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-4-4"></path>
        </svg>
      </button>

      <form action="/search" method="get" class="nav-search-form">
        <input
          type="search"
          name="q"
          class="nav-search-input"
          aria-label={labels.searchAria}
        />
        <button type="button" class="nav-search-close" aria-label={labels.searchCloseAria}>
          ✕
        </button>
      </form>
    </nav>
  </div>
</header>
